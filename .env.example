# Since local environment files are gitignored, use this file to
# build a new ".env.local" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy named
# ".env.local" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

TURSO_DATABASE_URL="turso://your-database.turso.io"
TURSO_AUTH_TOKEN="your-database-auth-token"
