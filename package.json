        "clsx": "^2.1.1",
        "contentlayer2": "0.5.8",
        "date-fns": "^4.4.0",
        "geist": "^1.7.2",
        "jotai": "^2.20.2",
        "lenis": "^1.3.25",
        "lucide-react": "^1.28.0",
        "motion": "^12.43.0",
        "next": "^16.2.12",
        "next-themes": "^0.4.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
