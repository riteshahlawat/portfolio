{
    "name": "portfolio",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.13.0 <25"
    },
    "scripts": {
        "build": "contentlayer2 build && next build --turbopack",
        "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
